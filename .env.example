# Copy to .env and fill in real values.
# `docker compose up` 명령은 이 .env를 자동으로 읽어 yml에 substitution.
# 운영 배포 시 시크릿 값들은 secret manager에서 주입하거나, 별도 .env.prod로 관리.

# ---- 환경 ----
# dev | staging | prod  — prod로 설정 시 config.py가 약한 시크릿/CORS 와일드카드를 자동 거절.
ENV=dev

# ---- PostgreSQL ----
POSTGRES_USER=before
# 운영에서는 강한 비밀번호로 교체 (예: openssl rand -base64 24).
POSTGRES_PASSWORD=before
POSTGRES_DB=before

# ---- API ↔ DB ----
# 일반적으로 위 POSTGRES_* 변수로 docker-compose가 자동 조립하므로 따로 설정 불필요.
# 컨테이너 외부에서 직접 연결할 때만 명시.
# DATABASE_URL=postgresql+asyncpg://before:before@localhost:5432/before

# ---- JWT ----
# 운영에서는 반드시 `openssl rand -hex 32`로 생성한 32자 이상 값으로 교체.
# dev/기본값을 prod ENV에서 사용하면 config.py가 부팅 거절.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=1209600

# ---- CORS ----
# 콤마 구분. 운영에서는 와일드카드(*) 사용 금지 (config.py 검증).
CORS_ORIGINS=http://localhost:3000

# ---- 외부 데이터 ----
# https://fredaccount.stlouisfed.org/apikey — 무료 발급.
FRED_API_KEY=
