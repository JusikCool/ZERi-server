# Copy to .env and fill in real values.
#
# 운영 환경(env != dev) 진입 시 config.py 의 _validate_production_secrets 가
# JWT_SECRET 기본/취약 값을 거부함 — 부팅 단계에서 즉시 실패.

ENV=dev
# 운영: ENV=prod (Railway/EC2 등). 이 값이 dev/test 가 아니면 보안 검증 활성화.

# Postgres
DATABASE_URL=postgresql+asyncpg://before:before@localhost:5432/before
# Railway: DATABASE_URL 은 Postgres 플러그인이 자동 주입.

# 컨테이너 포트 — Railway/Cloud Run 은 $PORT 를 동적 주입.
# 미설정 시 entrypoint 가 8000 으로 폴백.
PORT=8000

# JWT (Phase 0: HS256, Phase 1+: RS256 + key rotation per spec §11)
# 운영 키 생성: `openssl rand -hex 32`
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=1209600

# CORS (comma-separated). 운영 진입 시 프런트 도메인 추가.
# 예: CORS_ORIGINS=https://before.app,https://www.before.app
CORS_ORIGINS=http://localhost:3000

# FRED (https://fredaccount.stlouisfed.org/apikey — free, instant)
FRED_API_KEY=
