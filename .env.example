# Copy to .env and fill in real values.
#
# ⚠ 운영 환경(env=prod/production/live) 진입 시:
#   - config.py 의 _validate_production_secrets 가 JWT_SECRET / CORS_ORIGINS 를 검증
#   - docker-compose.yml 의 ${VAR:?} 가 미설정 시 부팅 자체를 거부
#   - 둘 다 통과해야만 컨테이너가 뜸 — 사고를 부팅 단계에서 막는 2중 가드

# ============================================================================
# 환경 식별
# ============================================================================
# dev / development / local     → 로컬 개발 (안전 검증 스킵)
# test / testing / ci           → 테스트 환경 (안전 검증 스킵)
# prod / production / live      → 운영 환경 (안전 검증 활성)
ENV=dev

# 컨테이너 포트 — Railway/Cloud Run 은 $PORT 동적 주입. 로컬은 8000 폴백.
PORT=8000

# ============================================================================
# Postgres
# ============================================================================
# docker-compose 가 ${VAR:?} 로 강제 — 미설정 시 compose up 자체 실패.
# 운영 시 강한 비밀번호로 교체: `openssl rand -base64 24`
POSTGRES_USER=before
POSTGRES_PASSWORD=before
POSTGRES_DB=before

# Compose 외부에서 DB 연결할 때 (외부 RDS / Railway Postgres 플러그인 등) 직접 사용.
# Compose 내부에선 자동으로 위 POSTGRES_* 로부터 조립됨.
# Railway: 플러그인 추가하면 DATABASE_URL 자동 주입 — 이 값은 무시됨.
DATABASE_URL=postgresql+asyncpg://before:before@localhost:5432/before

# ============================================================================
# JWT
# ============================================================================
# 운영 키 생성: `openssl rand -hex 32`
# 운영(env=prod) 진입 시 32자 미만이거나 기본/취약값이면 부팅 거부.
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=1209600

# ============================================================================
# CORS (comma-separated)
# ============================================================================
# 운영 진입 시 * 와일드카드 거부, localhost-only 도 거부 — 명시적 프런트 도메인 필요.
# 예: CORS_ORIGINS=https://before.app,https://www.before.app
CORS_ORIGINS=http://localhost:3000

# ============================================================================
# 운영자 / cron 전용 키
# ============================================================================
# /v1/risk/sync/*, /v1/prices/sync-history/*, /v1/macro/sync/*, /v1/tickers/sync/*
# 라우트는 X-Operator-Key 헤더 검증으로 보호됨. 일반 사용자 JWT 와 별개.
# 생성: `openssl rand -hex 32`
# GitHub Actions cron 이 secrets.OPERATOR_API_KEY 로 헤더에 주입.
# 운영(env=prod) 진입 시 32자 미만 / 빈 값 / JWT_SECRET 와 동일하면 부팅 거부.
OPERATOR_API_KEY=

# ============================================================================
# 외부 데이터
# ============================================================================
# FRED API key — https://fredaccount.stlouisfed.org/apikey (무료, 즉시 발급)
FRED_API_KEY=
